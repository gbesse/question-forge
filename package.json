{
  "name": "@gbesse/question-forge",
  "version": "0.1.0",
  "description": "Compare typed decision questions on separate development and held-out datasets with bounded experiments.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.mts",
      "import": "./src/index.mjs"
    },
    "./jev": {
      "types": "./src/jev.d.mts",
      "import": "./src/jev.mjs"
    }
  },
  "bin": {
    "question-forge": "./bin/question-forge.mjs"
  },
  "files": [
    "src",
    "bin",
    "examples",
    "README.md",
    "LICENSE",
    "docs/plugins.md"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "typecheck": "tsc --noEmit --strict --target ES2022 --module NodeNext docs/public-api-types.mts",
    "test": "node --test",
    "demo": "node examples/demo.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gbesse/question-forge.git"
  },
  "dependencies": {
    "@gbesse/decisionpacks": "git+https://github.com/gbesse/decisionpacks.git#3c90b6e667c16653b9a6ae00b376df9bddbd8461"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
